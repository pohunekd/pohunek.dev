{
  "$comment": "Every ecosystem release this site names. .github/workflows/follow-release.yml moves each version to the product's newest release once its assets verify; scripts/follow-releases.ts does it by hand. Asset names take {version}; every asset is checked against its .sha256 file and, when attested, with gh attestation verify bound to signerWorkflow and the release tag.",
  "apiUrl": "https://api.github.com",
  "changelogDir": "src/data/changelog",
  "products": [
    {

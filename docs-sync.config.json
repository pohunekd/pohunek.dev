{
  "$comment": "Source docs rendered by scripts/sync-docs.ts, one source per product. Each source reads the repository and pinned tag of its product in releases.config.json and renders the files matched by its pages into <contentRoot>/<routePrefix>/; every other file of the pinned ref is linked to its GitHub URL. Every routePrefix is one path segment of its own, so syncing one product never removes another's pages. The pohunek docs home is src/pages/docs/index.astro, owned by this site.",
  "contentRoot": "src/content/docs",
  "generatedDir": "src/data/generated",
  "cacheDir": ".cache/docs-sync",
  "githubUrl": "https://github.com",
  "rawUrl": "https://raw.githubusercontent.com",
  "sources": [
    {
      "product": "pohunek",
      "routePrefix": "docs",
      "editBranch": "main",
      "pages": [
        {
          "source": "docs/install.md",
          "route": "install"
        },
        {
          "source": "docs/cli.md",
          "route": "cli"
        },
        {
          "source": "docs/sdk.md",
          "route": "sdk"
        },
        {
          "source": "docs/public-api.md",
          "route": "protocol"
        },
        {
          "source": "docs/features.md",
          "route": "features"
        },
        {
          "source": "docs/architecture.md",
          "route": "architecture"
        },
        {
          "source": "docs/knowledge/concepts/**/*.md",
          "routeBase": "docs/knowledge"
        },
        {
          "source": "docs/knowledge/guides/**/*.md",
          "routeBase": "docs/knowledge"
        },
        {
          "source": "docs/knowledge/runbooks/**/*.md",
          "routeBase": "docs/knowledge"
        },
        {
          "source": "docs/knowledge/safety/**/*.md",
          "routeBase": "docs/knowledge"
        }
      ],
      "installPrompt": {
        "readme": "README.md",
        "heading": "## Install with an agent",
        "output": "install-prompt.txt"
      }
    }
  ]
}

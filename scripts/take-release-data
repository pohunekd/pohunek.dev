#!/usr/bin/env bash
# Copies the release data (collect's or finalize's artifact) from an unpacked artifact into this checkout.
# Usage: take-release-data <artifact directory>. Every entry of the artifact must be releases.config.json
# or src/data/changelog/<product id>.json, as a regular file; anything else (another path, a symlink,
# a device, a dotfile) aborts before a single file is copied. The artifact may also hold commit-message.txt,
# the release commit message; it is validated (a subject of at most 100 printable characters, either
# "Record ecosystem changelog" or "Follow ...", and for "Follow" optionally a blank line and up to 64
# "- <release>" lines of at most 200 characters), never copied, and read by the caller from the artifact directory.
set -euo pipefail
# Character classes and lengths below are meant for UTF-8 text (product names such as "Šafář").
export LC_ALL=C.UTF-8

if [ "$#" -ne 1 ]; then
  echo "usage: take-release-data <artifact directory>" >&2
  exit 1
fi
source_dir="$1"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ ! -d "$source_dir" ] || [ -L "$source_dir" ]; then
  echo "take-release-data: $source_dir is not a directory" >&2
  exit 1
fi

allowed_file='^(releases\.config\.json|commit-message\.txt|src/data/changelog/[a-z][a-z0-9-]*\.json)$'
message_file='commit-message.txt'
subject_pattern='^(Record ecosystem changelog|Follow [[:print:]]+)$'
body_line_pattern='^- [[:print:]]+$'
# subject_max_length must equal SUBJECT_MAX_LENGTH in commit-summary.ts (a test compares them).
subject_max_length=100
body_line_max_length=200
body_max_lines=64
allowed_dir='^(src|src/data|src/data/changelog)$'

files=()
while IFS= read -r -d '' entry; do
  relative="${entry#"$source_dir"/}"
  if [ -L "$entry" ]; then
    echo "take-release-data: refusing symlink $relative" >&2
    exit 1
  elif [ -d "$entry" ]; then
    if ! [[ "$relative" =~ $allowed_dir ]]; then
      echo "take-release-data: refusing directory $relative" >&2
      exit 1
    fi
  elif [ -f "$entry" ]; then
    if ! [[ "$relative" =~ $allowed_file ]]; then
      echo "take-release-data: refusing file $relative" >&2
      exit 1
    fi
    if [ "$relative" = "$message_file" ]; then
      mapfile -t message_lines < "$entry"
      if [ "${#message_lines[@]}" -eq 0 ] \
        || [ "${#message_lines[0]}" -gt "$subject_max_length" ] \
        || ! [[ "${message_lines[0]}" =~ $subject_pattern ]]; then
        echo "take-release-data: $message_file does not start with a valid commit subject" >&2
        exit 1
      fi
      if [ "${#message_lines[@]}" -gt 1 ]; then
        # A body is a blank line followed by "- <release>" lines, only after a "Follow" subject.
        if [ "${#message_lines[@]}" -gt "$((body_max_lines + 2))" ] \
          || [ -n "${message_lines[1]}" ] \
          || [ "${#message_lines[@]}" -lt 3 ] \
          || [[ "${message_lines[0]}" != Follow\ * ]]; then
          echo "take-release-data: $message_file has an invalid body" >&2
          exit 1
        fi
        for body_line in "${message_lines[@]:2}"; do
          if [ "${#body_line}" -gt "$body_line_max_length" ] || ! [[ "$body_line" =~ $body_line_pattern ]]; then
            echo "take-release-data: $message_file has an invalid body line" >&2
            exit 1
          fi
        done
      fi
    else
      files+=("$relative")
    fi
  else
    echo "take-release-data: refusing special file $relative" >&2
    exit 1
  fi
done < <(find "$source_dir" -mindepth 1 -print0)

has_config=false
for relative in "${files[@]}"; do
  if [ "$relative" = releases.config.json ]; then
    has_config=true
  fi
done
if [ "$has_config" != true ]; then
  echo "take-release-data: the artifact has no releases.config.json" >&2
  exit 1
fi

for relative in "${files[@]}"; do
  install -m 0644 -D -T "$source_dir/$relative" "$repo_root/$relative"
  echo "take-release-data: $relative"
done

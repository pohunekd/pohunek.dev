---
/**
 * Product page of Šafář review (the `autoreview` service). Its docs under /autoreview/ are synced from the
 * autoreview repository at the pinned tag; this page only routes readers into them, so it is owned by the website.
 */
import Banner from '../../components/Banner.astro';
import { banners } from '../../data/banners';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { pinnedTag, product } from '../../data/ecosystem';

const repoUrl = `https://github.com/${product('autoreview').repository}`;
const tag = pinnedTag('autoreview');

const lifecycle = [
	{
		title: 'Finds the work',
		text: 'A pull request that requests a review from the service account, or carries a label you choose, becomes a candidate. A burst of pushes is reviewed once.',
		href: '/autoreview/concepts/how-it-works/',
	},
	{
		title: 'Follows a policy',
		text: 'Rules map repositories to a pipeline and to the outcomes the review may publish. The first matching rule wins.',
		href: '/autoreview/policy/',
	},
	{
		title: 'Runs agents as reviewers',
		text: 'Claude Code or Codex, each in its own pohunek session on your hosts, through an adapter that enforces a read-only run and a structured result.',
		href: '/autoreview/concepts/reviewers-and-adapters/',
	},
	{
		title: 'Checks findings',
		text: 'An optional verifier re-checks each blocking finding against the code and turns the ones it cannot confirm into notes, with the reason.',
		href: '/autoreview/concepts/verification/',
	},
	{
		title: 'Decides what to publish',
		text: 'Blocking findings request changes or comment. A clean review approves, comments, or waits for a human.',
		href: '/autoreview/concepts/decisions/',
	},
	{
		title: 'Re-reviews what changed',
		text: 'After a push, the new commits are reviewed and every earlier blocking finding is settled as fixed, still open, or answered.',
		href: '/autoreview/concepts/incremental-reviews/',
	},
];

const safety = [
	{
		title: 'Read-only reviewers',
		text: 'The agents run in pohunek sessions on hosts you control, under the model accounts you configure. Only the service writes to GitHub, with the credential you give it per repository.',
		href: '/autoreview/safety/threat-model/',
	},
	{
		title: 'Untrusted authors',
		text: 'Each rule states which authors are trusted. Untrusted authors and their forks are reviewed from the base checkout and never approved automatically.',
		href: '/autoreview/safety/untrusted-authors/',
	},
	{
		title: 'Pull request text is data',
		text: 'The prompts tell reviewers not to follow instructions in a diff, a comment or a repository file, and the engine enforces its checks whatever the model does. An optional text guard makes an automatic approval wait for a person.',
		href: '/autoreview/safety/prompt-injection/',
	},
	{
		title: 'Human approval',
		text: 'A clean review can wait for your approval, given from the CLI or a chat integration and bound to the exact head commit.',
		href: '/autoreview/guides/human-approval/',
	},
];
---

<MarketingLayout
	title="Šafář review"
	description="Šafář review reviews GitHub pull requests with the coding agents you already run, as read-only reviewers in pohunek sessions on your own machines."
>
	<section class="container hero-with-banner">
		<header class="page-hero">
			<span class="eyebrow">Built on pohunek</span>
			<h1>Šafář review</h1>
			<p class="lead">
				A small service that reviews GitHub pull requests with the coding agents you already run. It runs Claude Code or
				Codex as read-only reviewers in pohunek sessions on your own machines, checks their findings, and publishes one
				GitHub review with inline comments. It does not run in GitHub Actions.
			</p>
			<p class="muted">
				Released as <a class="text-link" href={`${repoUrl}/releases/tag/${tag}`}>{tag}</a>; the docs below are rendered
				from <a class="text-link" href={repoUrl}>its repository</a> at that tag.
			</p>
			<div class="actions">
				<a class="button" href="/autoreview/guides/getting-started/">Get started</a>
				<a class="button secondary" href="/autoreview/features/">Read the docs</a>
			</div>
		</header>
		<Banner banner={banners.autoreview} />
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">How a review runs</span>
			<h2>From a review request to one GitHub review</h2>
		</div>
		<div class="grid cols-3">
			{lifecycle.map((step) => (
				<a class="card" href={step.href}>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</a>
			))}
		</div>
		<p class="muted">
			Every published finding keeps its <a class="text-link" href="/autoreview/concepts/finding-outcomes/">outcome</a>,
			such as fixed, answered, refuted by the verifier, or still open when the pull request is merged or closed. The
			<a class="text-link" href="/autoreview/concepts/review-report/">review report</a> turns them into review times,
			approval shares and outcomes per reviewer, and can close the review-queue digest once a week.
		</p>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Safety</span>
			<h2>Reviewers read, people decide</h2>
		</div>
		<div class="grid cols-2">
			{safety.map((item) => (
				<a class="card" href={item.href}>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</a>
			))}
		</div>
	</section>
</MarketingLayout>

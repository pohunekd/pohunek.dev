---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Not found" description="This page does not exist.">
	<section class="container page-hero">
		<span class="eyebrow">404</span>
		<h1>This furrow leads nowhere</h1>
		<p class="lead">The page you asked for does not exist, or it moved when the docs were reorganised.</p>
		<div class="actions">
			<a class="button" href="/">Back to the field</a>
			<a class="button secondary" href="/docs/">Read the docs</a>
		</div>
	</section>
</MarketingLayout>

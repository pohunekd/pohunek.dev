---
import Banner from '../components/Banner.astro';
import { banners } from '../data/banners';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { site } from '../config/site';
import { surfaces } from '../data/surfaces';
import { nextMilestone, roadmapAsOf, roadmapRelease, roadmapTracks } from '../data/roadmap';
import { timeline } from '../data/changelog';
import { splitRelease } from '../lib/release-sections';
import { product } from '../data/ecosystem';

const issueUrl = (number: number): string => `${site.issuesUrl}/${number}`;
const milestoneUrl = `${site.repoUrl}/milestone/${nextMilestone.number}`;

const dateFormat = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

/** The newest core releases, summarized from the recorded changelog so the list follows each release. */
const recentReleases = timeline([product('pohunek')])
	.slice(0, 5)
	.map(({ release }) => ({
		release,
		summary: splitRelease(release.markdown, release.source).summary,
		date: dateFormat.format(new Date(release.publishedAt)),
	}));
---

<MarketingLayout
	title="Roadmap"
	description="Where pohunek's runtime, durability and surface work stands, with links to the epics that track it."
>
	<section class="container hero-with-banner">
		<header class="page-hero">
			<span class="eyebrow">Roadmap</span>
			<h1>Tracks and their state</h1>
			<p class="lead">
				Each track links to its epic on GitHub. Progress counts come from the epic's child issues on {roadmapAsOf}, after
				pohunek {roadmapRelease}. pohunek is pre-1.0 and experimental, so wire shapes and config files may change between
				releases.
			</p>
		</header>
		<Banner banner={banners.roadmap} />
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Next release</span>
			<h2>
				Milestone <a href={milestoneUrl}>{nextMilestone.title}</a>
			</h2>
			<p class="lead">
				{nextMilestone.progress.done} of {nextMilestone.progress.total} issues closed on {roadmapAsOf}. What is still
				open in it:
			</p>
			<div
				class="progress"
				aria-label={`${nextMilestone.progress.done} of ${nextMilestone.progress.total} issues closed`}
			>
				<progress value={nextMilestone.progress.done} max={nextMilestone.progress.total} />
				<span class="mono">{nextMilestone.progress.done}/{nextMilestone.progress.total}</span>
			</div>
		</div>
		<ul class="epics">
			{
				nextMilestone.epics.map((epic) => (
					<li>
						<a class="text-link" href={issueUrl(epic.issue)}>
							#{epic.issue} {epic.title}
						</a>
						<span class="muted">{epic.outcome}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Shipped</span>
			<h2>Recent core releases</h2>
		</div>
		<div class="table-wrap">
			<table class="ledger releases">
				<thead>
					<tr><th>Release</th><th>What it brought</th></tr>
				</thead>
				<tbody>
					{
						recentReleases.map(({ release, summary, date }) => (
							<tr>
								<td>
									<a href={`/changelog/pohunek/#pohunek-${release.version}`}>{release.tag}</a>
									<span class="mono date">{date}</span>
								</td>
								<td>{summary}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Core</span>
			<h2>Daemon and protocol tracks</h2>
		</div>
		<div class="grid cols-2">
			{
				roadmapTracks.map((track) => (
					<article class="card track">
						<div class="track-head">
							<StatusBadge status={track.status} note={track.statusNote} />
						</div>
						<h3>{track.title}</h3>
						<p>{track.goal}</p>
						{track.progress && (
							<div class="progress" aria-label={`${track.progress.done} of ${track.progress.total} child issues done`}>
								<progress value={track.progress.done} max={track.progress.total} />
								<span class="mono">{track.progress.done}/{track.progress.total}</span>
							</div>
						)}
						<div class="card-foot issue-links">
							{track.issues.map((issue) => (
								<a class="text-link" href={issueUrl(issue.number)}>#{issue.number}</a>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Surfaces</span>
			<h2>Clients of the same contract</h2>
		</div>
		<div class="table-wrap">
			<table class="ledger">
				<thead>
					<tr><th>Surface</th><th>Status</th></tr>
				</thead>
				<tbody>
					{
						surfaces.map((surface) => (
							<tr>
								<td><a href={`/surfaces/${surface.slug}/`}>{surface.name}</a></td>
								<td><StatusBadge status={surface.status} note={surface.statusNote} /></td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section class="container section">
		<div class="actions">
			<a class="button secondary" href={site.milestonesUrl}>Milestones</a>
			<a class="button secondary" href={site.releasesUrl}>Releases</a>
			<a class="button secondary" href={site.issuesUrl}>All issues</a>
		</div>
	</section>
</MarketingLayout>

<style>
	.track {
		gap: 0.6rem;
	}
	.track-head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.progress {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.progress progress {
		flex: 1;
		height: 0.6rem;
		accent-color: var(--leather);
	}
	table.ledger.releases {
		min-width: 0;
	}
	.releases .date {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--ink-faint);
		white-space: nowrap;
	}
	.releases td:first-child {
		width: 9rem;
	}
	.epics {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.9rem;
	}
	.epics li {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--rule);
	}
	.issue-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.9rem;
	}
</style>

---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { site } from '../config/site';
import { surfaces } from '../data/surfaces';
import { roadmapTracks } from '../data/roadmap';

const issueUrl = (number: number): string => `${site.issuesUrl}/${number}`;
---

<MarketingLayout
	title="Roadmap"
	description="Where pohunek's runtime, workflow, durability and surface work stands, with links to the epics that track it."
>
	<section class="container">
		<header class="page-hero">
			<span class="eyebrow">Roadmap</span>
			<h1>Tracks and their state</h1>
			<p class="lead">
				Each track links to its epic on GitHub. Progress counts come from the epic's child issues at the time of writing.
				pohunek is pre-1.0 and experimental, so wire shapes and config files may change between releases.
			</p>
		</header>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Core</span>
			<h2>Daemon and protocol tracks</h2>
		</div>
		<div class="grid cols-2">
			{
				roadmapTracks.map((track) => (
					<article class="card track">
						<div class="track-head">
							<StatusBadge status={track.status} note={track.statusNote} />
						</div>
						<h3>{track.title}</h3>
						<p>{track.goal}</p>
						{track.progress && (
							<div class="progress" aria-label={`${track.progress.done} of ${track.progress.total} child issues done`}>
								<progress value={track.progress.done} max={track.progress.total} />
								<span class="mono">{track.progress.done}/{track.progress.total}</span>
							</div>
						)}
						<div class="card-foot issue-links">
							{track.issues.map((issue) => (
								<a class="text-link" href={issueUrl(issue.number)}>#{issue.number}</a>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Surfaces</span>
			<h2>Clients of the same contract</h2>
		</div>
		<div class="table-wrap">
			<table class="ledger">
				<thead>
					<tr><th>Surface</th><th>Status</th></tr>
				</thead>
				<tbody>
					{
						surfaces.map((surface) => (
							<tr>
								<td><a href={`/surfaces/${surface.slug}/`}>{surface.name}</a></td>
								<td><StatusBadge status={surface.status} note={surface.statusNote} /></td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section class="container section">
		<div class="actions">
			<a class="button secondary" href={site.milestonesUrl}>Milestones</a>
			<a class="button secondary" href={site.releasesUrl}>Releases</a>
			<a class="button secondary" href={site.issuesUrl}>All issues</a>
		</div>
	</section>
</MarketingLayout>

<style>
	.track {
		gap: 0.6rem;
	}
	.track-head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.progress {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.progress progress {
		flex: 1;
		height: 0.6rem;
		accent-color: var(--leather);
	}
	.issue-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.9rem;
	}
</style>

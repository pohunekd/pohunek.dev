---
import Banner from '../../components/Banner.astro';
import Screenshot from '../../components/Screenshot.astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Icon from '../../components/Icon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CopyBox from '../../components/CopyBox.astro';
import { site } from '../../config/site';
import { isPrerelease } from '../../../scripts/lib/releases-config';
import { getBanner } from '../../data/banners';
import { pinnedTag, product } from '../../data/ecosystem';
import { installCommands } from '../../data/releases';
import { surfaces, getSurface } from '../../data/surfaces';

export function getStaticPaths() {
	return surfaces.map((surface) => ({ params: { slug: surface.slug } }));
}

interface Detail {
	/** Longer paragraph under the hero. */
	body: string;
	features: readonly { title: string; text: string }[];
	/** Install routes: a heading, an optional sentence of context, and shell lines. */
	install: { title: string; intro?: string; lines: readonly string[] }[];
	notes?: readonly string[];
	/** A caution shown under the hero, for surfaces that are not ready for daily use. */
	notice?: string;
}

const details: Record<string, Detail> = {
	sway: {
		body: 'A set of small shell scripts that put your agents on Sway keybindings: a rofi switcher over the sessions of every host, launchers that start an agent on a Linear issue or GitHub PR, and a new-session form. They call the pohunek CLI and nothing else, so they install on their own; pohunek-work is optional. Sway is the window manager they ship for today, and the same scripts are meant to drive other window managers too.',
		features: [
			{
				title: 'Switch between agents with $mod+p',
				text: 'pohunek-rofi lists the sessions of every reachable host with project, branch, agent, state and activity. Pick one or several: their attach terminals open, and the attach windows you did not pick close, which only detaches you. --filter key=value narrows the list before it reaches rofi, for example only blocked sessions.',
			},
			{
				title: 'Closing a window detaches, never stops',
				text: 'The switcher only opens terminals that run pohunek attach. Closing one detaches you; the agent keeps running on its durable worker.',
			},
			{
				title: 'Start an agent on an issue or a PR',
				text: 'pohunek-rofi-issue <project> linear lists your actionable Linear issues and pohunek-launch-issue starts an agent on the one you pick, with its prompt rendered by pohunek prompt render and the issue link stored as session metadata. pohunek-launch-pr does the same for a GitHub pull request. The GitHub issue source goes through pohunek-work.',
			},
			{
				title: 'New session form on $mod+n',
				text: 'pohunek-new-session opens the pohunek-work new-session form in your terminal. This binding is the one part that needs pohunek-work; pohunek-work setup sway adds it.',
			},
		],
		install: [
			{
				title: 'Requirements',
				intro: 'pohunek installed and running, plus rofi, swaymsg, python3 and a terminal emulator.',
				lines: ['command -v pohunek rofi swaymsg python3'],
			},
			{
				title: 'Get the scripts: release archive',
				intro: 'Verified download of the launcher release.',
				lines: installCommands.launchersFromRelease,
			},
			{
				title: 'Or get the scripts: from source',
				intro: 'The same files live in the launchers/ directory of the repository.',
				lines: installCommands.launchersFromSource,
			},
			{
				title: 'Install them (from either directory)',
				intro: 'Copies the scripts, launcher.conf and prompt templates into the same XDG paths pohunek-work setup uses, and binds the switcher to $mod+p. Existing config files are kept. Your sway config must include ~/.config/sway/config.d/*, and terminal= in launcher.conf names your terminal.',
				lines: installCommands.launchersCopy,
			},
			{
				title: 'Or let pohunek-work do it',
				intro: 'With pohunek-work installed (see the Terminal TUI page), setup writes the same files and adds the $mod+n new-session binding; doctor checks every requirement.',
				lines: installCommands.launchersWithWork,
			},
		],
		notes: [
			'Optional bindings: bindsym $mod+i exec exec ~/.local/share/pohunek/bin/pohunek-rofi-issue <project> linear starts the issue picker for one project.',
			'The scripts read ~/.config/pohunek/launcher.conf: host, terminal, list timeout, the Linear CLI and the pohunek-work binary. pohunek attach reads its own attach keys from the same file.',
		],
	},
	companion: {
		body: 'A small native app (Rust and Slint) for the owner of a daemon. It owns no session state: the daemon runs the sessions and the companion shows them and starts new ones.',
		features: [
			{
				title: 'Live state and attention',
				text: 'Every row shows the agent, its state (working, idle, needs owner, ended) and its Work link. Sessions that need you sit in a Needs you section at the top. An idle session counts as idle only after a configurable threshold.',
			},
			{
				title: 'Tray badge',
				text: 'The tray icon carries a badge with the number of sessions that need you, colored by the most urgent state. Its menu attaches to them directly. A Linux tray needs a StatusNotifierItem host.',
			},
			{
				title: 'Groups by drag and drop',
				text: 'Drag rows and group headers into your own groups. Groups can be renamed, collapsed and deleted. The layout is stored per user, never in the daemon.',
			},
			{
				title: 'Filters and search',
				text: 'Chips narrow the list by project and by state. A text filter (Ctrl+F, or Cmd+F on macOS) searches names. Ended sessions stay hidden until their chip is on.',
			},
			{
				title: 'Session detail',
				text: 'The details view lists the session id, host, agent, state, working directory, project and Work metadata, each with a copy button. An ended session that the daemon can resume gets a Resume action.',
			},
			{
				title: 'New session and Assistant',
				text: 'Both dialogs are separate processes, so they can also be bound to a desktop keybinding with pohunek-companion new-session or assistant.',
			},
			{
				title: 'Other hosts',
				text: 'The companion can follow daemons on other machines over the NetBird overlay. A host that drops off keeps its last rows dimmed and marked unreachable.',
			},
			{
				title: 'Install from the app',
				text: 'Without a daemon the window shows a setup screen. On Linux x86_64 its Install button downloads the matching Pohunek release from GitHub, checks the sha256 and attestation when gh is signed in, shows what the installer will write, and runs it only after you confirm.',
			},
		],
		install: [
			{
				title: 'Linux x86_64',
				lines: [
					`v=${product('companion').version}`,
					'a=pohunek-companion-$v-x86_64-unknown-linux-gnu.tar.gz',
					'gh release download v$v -R pohunekd/pohunek-companion -p "$a*"',
					'sha256sum -c $a.sha256',
					'gh attestation verify $a --repo pohunekd/pohunek-companion',
					'tar -xzf $a && ./pohunek-companion-$v-x86_64-unknown-linux-gnu/pohunek-companion desktop install',
				],
			},
			{
				title: 'macOS (Apple Silicon)',
				lines: ['brew install zajca/pohunek/pohunek-companion'],
			},
		],
		notes: [
			'The companion needs a running pohunek daemon on the same machine. Without one it opens a setup screen that installs pohunek for you, see Install.',
		],
	},
	android: {
		body: 'A native Android app (Kotlin and Jetpack Compose) for the owner of one or more daemons. It speaks the public protocol over the NetBird overlay and keeps no session state of its own: the daemons run the sessions, the phone lists them, opens a terminal on them and starts new ones.',
		features: [
			{
				title: 'Live sessions from several hosts',
				text: 'One list holds the sessions of every host the app follows. Each row shows the agent, its owner state and its Work link. A host that drops off keeps its last rows, dimmed, until it is reachable again, and hosts that a connected daemon discovers on the NetBird overlay join the list without being stored.',
			},
			{
				title: 'Needs you first',
				text: 'Sessions that wait for you sit in a Needs you section at the top of every view. An idle session counts as idle only after a configurable threshold.',
			},
			{
				title: 'Views and filters',
				text: 'Switch the list between your own groups and read-only views by state, by project and by Work item. Chips narrow it by owner state, project and host, and a search field matches names, projects, agents and Work ids.',
			},
			{
				title: 'Groups shared with the desktop',
				text: 'Your groups are stored in the session metadata key companion.group, so the desktop companion shows the same membership. Create, rename and delete groups, move a session from its action sheet, and long-press a row or a group header to reorder. Order and collapse state stay on the phone.',
			},
			{
				title: 'Session actions and details',
				text: 'Every row has an action sheet: open the terminal, details, rename, start a new session next to it, move to a group, open its link, stop and remove. The details view lists the session id, host, agent, state and working directory, each with a copy button. An ended session that the daemon can resume gets a Resume action.',
			},
			{
				title: 'New session',
				text: 'Pick a host and a project, then start from a project template that fills the agent and the prompt, or from a blank form with an optional branch and base branch. A started session is created in the group of the row you launched it from.',
			},
			{
				title: 'Full-screen terminal',
				text: 'Open a session in a full-screen terminal, drawn by libghostty-vt, with an accessory bar for the keys a phone keyboard lacks. When the network drops, the terminal re-attaches with a growing wait, repaints from the daemon snapshot and gives up with an error only after a configurable time.',
			},
			{
				title: 'Settings and logs',
				text: 'Connection, liveness, reattach and display tunables live in one Settings list with their defaults and a reset. The app log can be exported through the Android share sheet.',
			},
		],
		install: [
			{
				title: isPrerelease(product('android').version) ? 'Install the pre-release APK' : 'Install the APK',
				intro: 'Releases are signed with one key. Download the APK and its checksum, verify both, then open the APK on the phone and allow installs from the app you open it with. A later release installs over this one and keeps your data. apksigner comes with the Android SDK build-tools; the certificate SHA-256 digest it prints must equal the one in the release notes.',
				lines: [
					`v=${product('android').version}`,
					'gh release download v$v -R pohunekd/pohunek-companion-android -p "pohunek-companion-$v.apk*"',
					'sha256sum -c pohunek-companion-$v.apk.sha256',
					'apksigner verify --print-certs pohunek-companion-$v.apk',
				],
			},
		],
		notes: [
			'Requirements: Android 13 or newer, the official NetBird app on the phone, and a Pohunek daemon reachable over the overlay. The app does not run a daemon, and the daemon has no authentication of its own: the NetBird overlay is the security boundary.',
			'Status: pre-release. Install the APK from the releases page.',
			'Not there yet: starting an assistant session, which waits on the daemon side (zajca/pohunek#1532), and background notifications. The list and the terminal update only while the app is open.',
		],
	},
	tui: {
		body: 'pohunek-work is a Bun plugin with an Ink terminal interface. It answers one question for every open work item: who has to act next, me, an agent or a reviewer?',
		features: [
			{
				title: 'Work',
				text: 'Joins Linear, GitHub and pohunek sessions into one list of work items, with the next action for each.',
			},
			{
				title: 'Sessions, Hosts and Activity',
				text: 'Sessions grouped by Needs you, Running, Ready and Unavailable. Attach, stop and remove from the same view. Hosts and Activity use the public pohunek --json commands.',
			},
			{
				title: 'Keyboard and mouse',
				text: 'Tab and 1 to 4 switch views, arrows move the selection, Enter opens. Press ? for the keys.',
			},
		],
		install: [
			{
				title: 'Install pohunek-work (Linux and macOS, needs Bun)',
				intro: 'The release archive is a Bun program. These lines verify it, put it under ~/.local/lib and add a pohunek-work command to ~/.local/bin.',
				lines: installCommands.pluginLinux,
			},
			{
				title: 'Configure and run',
				intro: 'doctor reports a missing config until you write ~/.config/pohunek/plugins/work/config.toml. Every key is required, there are no hidden defaults; the plugin guide lists them. Projects go in ~/.config/pohunek/plugins/work/projects/<label>.toml.',
				lines: ['pohunek-work doctor', 'pohunek-work tui'],
			},
		],
		notes: [
			`Status: ${pinnedTag('plugin')} is released, and the plugin README still lists the Sessions, Hosts and Activity views as in progress. Check the release notes for the exact scope.`,
		],
	},
	web: {
		notice: 'Experimental. The web control center works, but it needs a lot of love before it is pleasant to use every day. For daily work use the desktop companion, the Sway launchers or the terminal TUI.',
		body: 'A self-hosted owner web control center: one backend origin serves a Svelte single-page app and reports your hosts. It is a client over the public protocol, and the CLI and launchers keep working when it is down.',
		features: [
			{
				title: 'Session rail across hosts',
				text: 'A persistent workspace shell lists every host, groups normal work by project and promotes the sessions that need you.',
			},
			{
				title: 'Attach over WebSocket',
				text: 'The backend exposes a transparent control or attach WebSocket per daemon. The backend is not authoritative: each daemon still owns its sessions, events and notifications.',
			},
			{
				title: 'Mesh-local owner tool',
				text: 'It is meant for your own machines over the overlay. It is not the optional team relay.',
			},
		],
		install: [
			{
				title: 'Linux x86_64',
				intro: 'Verified download, then install.sh puts the backend and the browser app under your XDG data directory and writes a systemd user unit. The backend binds only to your NetBird address.',
				lines: installCommands.webLinux,
			},
			{
				title: 'macOS (Apple Silicon)',
				intro: 'Then set the bind address and port in ~/.config/pohunek/backend.env and run the installer again, as the formula output describes.',
				lines: installCommands.webMacos,
			},
		],
		notes: [
			`Released as ${pinnedTag('web')} for Linux x86_64 and macOS on Apple Silicon. The macOS build is ad hoc signed; Homebrew installs it without a Gatekeeper prompt.`,
		],
	},
};

const { slug } = Astro.params;
const surface = getSurface(slug!);
const detail = details[surface.slug];
const shots = surface.screenshots;
const repoLabel = surface.repoUrl.replace('https://github.com/', '');
---

<MarketingLayout title={surface.name} description={surface.summary}>
	<section class="container hero-with-banner">
		<header class="page-hero">
			<a class="text-link" href="/surfaces/">Back to surfaces</a>
			<span class="eyebrow"><Icon name={surface.icon} label="" /> {surface.platform}</span>
			<h1>{surface.name}</h1>
			<p class="lead">{detail.body}</p>
			{detail.notice && <p class="notice">{detail.notice}</p>}
			<div><StatusBadge status={surface.status} note={surface.statusNote} /></div>
			<div class="actions">
				<a class="button secondary" href={surface.repoUrl}>Source on GitHub ({repoLabel})</a>
				{surface.release && <a class="button secondary" href={`${surface.repoUrl}/releases/tag/${surface.release}`}>Release {surface.release}</a>}
			</div>
		</header>
		<Banner banner={getBanner(surface.slug)} />
	</section>

	{
		shots.length > 0 && (
			<section class="container section">
				<div class="section-head">
					<span class="eyebrow">Screenshots</span>
					<h2>What the app shows</h2>
					<p class="muted">Captured from an isolated daemon filled with synthetic sessions, not from real work.</p>
				</div>
				<div class="shots">
					{shots.map((shot) => (
						<Screenshot image={shot.image} alt={shot.alt} caption={shot.caption} density={shot.density} />
					))}
				</div>
			</section>
		)
	}

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Features</span>
			<h2>What it does</h2>
		</div>
		<div class="grid cols-2">
			{
				detail.features.map((feature) => (
					<article class="card">
						<h3>{feature.title}</h3>
						<p>{feature.text}</p>
					</article>
				))
			}
		</div>
	</section>

	{
		detail.install.length > 0 && (
			<section class="container section">
				<div class="section-head">
					<span class="eyebrow">Install</span>
					<h2>Get it running</h2>
				</div>
				<div class="install-stack">
					{detail.install.map((block) => (
						<div class="install-block">
							<h3>{block.title}</h3>
							{block.intro && <p class="muted">{block.intro}</p>}
							<CopyBox title="shell" text={block.lines.join('\n')} />
						</div>
					))}
				</div>
			</section>
		)
	}

	{
		detail.notes && (
			<section class="container section">
				<div class="section-head">
					<span class="eyebrow">Notes</span>
				</div>
				<ul class="notes">
					{detail.notes.map((note) => <li>{note}</li>)}
				</ul>
			</section>
		)
	}

	<section class="container section">
		<p class="muted">
			Every surface is a client of the same public CLI and protocol. See the <a class="text-link" href="/surfaces/">other surfaces</a>
			or the <a class="text-link" href="/docs/">docs</a>. Project home: <a class="text-link" href={site.repoUrl}>{site.repoUrl}</a>.
		</p>
	</section>
</MarketingLayout>

<style>
	.notice {
		max-width: 46rem;
		padding: 0.9rem 1.1rem;
		border: 1px dotted var(--rule-strong);
		border-left: 3px solid var(--leather);
		background: var(--paper-sunk);
		color: var(--ink);
	}
	.install-stack {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
	}
	.install-block {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.6rem;
		min-width: 0;
	}
	.install-block p {
		overflow-wrap: anywhere;
	}
	.notes {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.6rem;
		color: var(--ink-muted);
	}
	.shots {
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
	}
</style>

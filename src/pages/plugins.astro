---
import Banner from '../components/Banner.astro';
import { banners } from '../data/banners';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import CopyBox from '../components/CopyBox.astro';
import Icon from '../components/Icon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { site } from '../config/site';
import { getSurface } from '../data/surfaces';
import { indexDay, pendingPlugins, pluginIndex } from '../data/plugins';

const work = getSurface('tui');
const indexRepo = 'https://github.com/pohunekd/pohunek-plugin-index';

const builtIn = [
	{ name: 'Codex', status: 'shipped' as const, note: 'official runtime package' },
	{ name: 'Claude Code', status: 'shipped' as const, note: 'official runtime package' },
	{ name: 'Hermes', status: 'shipped' as const, note: 'official runtime package' },
	{ name: 'Pi', status: 'shipped' as const, note: 'official runtime package' },
	{ name: 'shell', status: 'shipped' as const, note: 'the only built-in runtime' },
	{ name: 'OpenCode 2.x', status: 'planned' as const, note: 'planned, zajca/pohunek#227' },
];

const runtimeCommands = `pohunek plugin list
pohunek plugin install pohunek.runtime.vibe
pohunek plugin install ./acme-pi-1.0.0.tar.zst --sha256 sha256:<64 hex>
pohunek plugin inspect acme.pi
pohunek plugin update acme.pi ./acme-pi-1.1.0.tar.zst --sha256 sha256:<64 hex> --yes
pohunek plugin doctor`;
---

<MarketingLayout
	title="Plugins"
	description="Runtime packages add agent CLIs to a host. Context packages carry knowledge, such as the assistant bundle."
>
	<section class="container hero-with-banner">
		<header class="page-hero">
			<span class="eyebrow">Plugins</span>
			<h1>Packages the daemon installs</h1>
			<p class="lead">
				Runtime packages teach the daemon a new agent CLI. Context packages carry knowledge, such as the bundle behind
				<code>pohunek assistant</code>. Both are signed, content-addressed archives installed per host.
			</p>
		</header>
		<Banner banner={banners.plugins} />
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Runtime packages</span>
			<h2>Agents the daemon can install by id</h2>
			<p class="muted">
				Every row below is rendered at build time from the signed official plugin index, the same document
				<code>pohunek plugin install</code> verifies. Admitting a package to
				<a class="text-link" href="https://github.com/pohunekd/pohunek-plugin-index">pohunek-plugin-index</a> puts it
				here, so a new plugin appears without a page edit.
			</p>
		</div>
		<div class="table-wrap">
			<table class="ledger">
				<thead>
					<tr><th>Plugin</th><th>Runtime</th><th>Tier</th><th>Description</th><th>Source</th></tr>
				</thead>
				<tbody>
					{
						pluginIndex.runtime.map((plugin) => (
							<tr>
								<td>
									{plugin.name}
									<span class="cell-note">{plugin.packageId} {plugin.version}</span>
								</td>
								<td><code>{plugin.runtimeId}</code></td>
								<td>{plugin.tier}</td>
								<td>{plugin.description}</td>
								<td><a class="text-link" href={plugin.repository}>{plugin.repositoryLabel}</a></td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="index-note">
			{
				pluginIndex.stale ? (
					<>
						The live index could not be read at build time, so this table is the committed snapshot fetched{' '}
						{indexDay(pluginIndex.fetchedAt)}. The index itself was signed {indexDay(pluginIndex.asOf)}.
					</>
				) : (
					<>
						Generated at build time from the signed plugin index signed {indexDay(pluginIndex.asOf)} and rendered{' '}
						{indexDay(pluginIndex.fetchedAt)}.
					</>
				)
			}
			{' '}The source is <a class="text-link" href={indexRepo}>pohunek-plugin-index</a>.
		</p>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Context packages</span>
			<h2>Knowledge the assistant reads</h2>
			<p class="muted">
				The assistant knowledge no longer ships inside the pohunek binaries. It is the context package behind
				<code>pohunek assistant</code>, installed by digest. Until it is installed, the command answers
				<code>assistant_package_missing</code> and names the step to take.
			</p>
		</div>
		<div class="table-wrap">
			<table class="ledger">
				<thead>
					<tr><th>Package</th><th>Tier</th><th>Description</th><th>Source</th></tr>
				</thead>
				<tbody>
					{
						pluginIndex.context.map((plugin) => (
							<tr>
								<td>
									{plugin.name}
									<span class="cell-note">{plugin.packageId} {plugin.version}</span>
								</td>
								<td>{plugin.tier}</td>
								<td>{plugin.description}</td>
								<td><a class="text-link" href={plugin.repository}>{plugin.repositoryLabel}</a></td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	{pendingPlugins.length > 0 && (
	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">In progress</span>
			<h2>Official plugins not admitted yet</h2>
			<p class="muted">
				These official plugin repositories are not in the index yet, so they cannot be installed by id. Each row moves into
				the runtime table above when its admission lands.
			</p>
		</div>
		<div class="table-wrap">
			<table class="ledger">
				<thead>
					<tr><th>Plugin</th><th>Runtime</th><th>Tier</th><th>Description</th><th>Source</th></tr>
				</thead>
				<tbody>
					{
						pendingPlugins.map((plugin) => (
							<tr>
								<td>{plugin.name}</td>
								<td><code>{plugin.runtime}</code></td>
								<td>{plugin.tier}</td>
								<td>{plugin.description}</td>
								<td><a class="text-link" href={plugin.repository}>{plugin.repositoryLabel}</a></td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>
	)}

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Built in</span>
			<h2>Runtimes that ship with the release</h2>
			<p class="muted">
				These runtimes are part of the release catalog instead of the plugin index. The four official agent runtimes
				stay in the core release until each moves to its own plugin repository.
			</p>
		</div>
		<div class="table-wrap">
			<table class="ledger">
				<thead>
					<tr><th>Runtime</th><th>Status</th><th>Note</th></tr>
				</thead>
				<tbody>
					{
						builtIn.map((runtime) => (
							<tr>
								<td>{runtime.name}</td>
								<td><StatusBadge status={runtime.status} /></td>
								<td>{runtime.note}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<div class="stack">
			<CopyBox title="pohunek plugin" text={runtimeCommands} />
		</div>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Featured</span>
			<h2>pohunek-work</h2>
		</div>
		<article class="card featured">
			<div class="card-kicker"><Icon name="package" label="" /><span>Companion tool</span></div>
			<h3>{work.name}</h3>
			<p>
				A companion tool that answers who has to act next on every open work item, joining Linear, GitHub and pohunek
				sessions. It ships a terminal interface, a rofi and sway launcher and a web control center.
			</p>
			<div class="card-foot">
				<StatusBadge status={work.status} note={work.statusNote} />
				<a class="text-link" href={work.repoUrl}>Source on GitHub</a>
			</div>
		</article>
	</section>

	<section class="container section">
		<p class="muted">
			Šafář review, the pull request reviewer, is neither a package the daemon installs nor part of pohunek-work. It is a
			separate product, listed under <a class="text-link" href="/built-on/">Built on pohunek</a>.
		</p>
	</section>

	<section class="container section">
		<div class="trust strip">
			<Icon name="shield" label="" />
			<div>
				<h3>Trust boundary</h3>
				<p>
					Packages run with your account's full authority, the same owner trust boundary as any script you run.
					The digest proves which bytes you approved. It does not confine them. Install only packages whose source you trust,
					and read what the consent step prints.
				</p>
			</div>
		</div>
	</section>

	<section class="container section">
		<div class="section-head">
			<span class="eyebrow">Write your own</span>
			<h2>Build a plugin</h2>
		</div>
		<div class="actions">
			<a class="button" href="/docs/guides/runtime-packages/">Runtime packages guide</a>
			<a class="button secondary" href="/docs/guides/ts-sdk/">TypeScript SDK guide</a>
		</div>
	</section>
</MarketingLayout>

<style>
	.stack {
		display: grid;
		gap: 0.9rem;
		align-content: start;
		margin-top: 1rem;
	}
	.cell-note {
		display: block;
		margin-top: 0.15rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
	}
	.index-note {
		margin-top: 0.8rem;
		font-size: 0.85rem;
		color: var(--ink-muted);
	}
	.card.featured {
		max-width: 48rem;
	}
	.card-kicker {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.card-kicker :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
	}
	.trust {
		display: flex;
		gap: 1.1rem;
		align-items: flex-start;
		padding: 1.4rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper-sunk);
		border-radius: var(--radius);
	}
	.trust :global(svg) {
		width: 2rem;
		height: 2rem;
		flex: none;
		color: var(--leather);
	}
	.trust p {
		margin-top: 0.4rem;
		color: var(--ink-muted);
	}
</style>
